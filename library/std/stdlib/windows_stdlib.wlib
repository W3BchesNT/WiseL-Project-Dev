@data {
    WVAR hStdOut, i64, ?
    WVAR bytesWritten, i32, ?
    readln_buf rb 256
    readln_count dd 0
    newline_buf db 13, 10
}

@include.inc {
    "win64w.inc"
}

@library kernel32 {
    GetStdHandle
    WriteConsoleA
    ExitProcess
    ReadConsoleA
}

inline print_str(s: str) {
    asm {
        mov rcx, -11
        call qword [GetStdHandle]
        mov rcx, rax
        mov rdx, {s}
        mov r8, {s}_len
        lea r9, [bytesWritten]
        mov qword [rsp+32], 0
        call qword [WriteConsoleA]
    }
}

inline print_readln_str() {
    asm {
        mov rcx, -11
        call qword [GetStdHandle]
        mov rcx, rax
        lea rdx, [readln_buf]
        mov r8d, [readln_count]
        sub r8d, 2
        lea r9, [bytesWritten]
        mov qword [rsp+32], 0
        call qword [WriteConsoleA]
    }
}

fn print_int(n: i32) {
    asm {
        push rbx
        push rdi
        sub rsp, 64

        mov r10d, ecx
        mov rcx, -11
        call qword [GetStdHandle]
        mov rbx, rax

        mov eax, r10d
        lea rdi, [rsp + 63]
        mov ecx, 10
    .print_int_loop:
        xor edx, edx
        div ecx
        add dl, '0'
        mov [rdi], dl
        dec rdi
        test eax, eax
        jnz .print_int_loop
        inc rdi

        mov rcx, rbx
        mov rdx, rdi
        lea r8, [rsp + 64]
        sub r8, rdi
        lea r9, [bytesWritten]
        mov qword [rsp + 32], 0
        call qword [WriteConsoleA]

        add rsp, 64
        pop rdi
        pop rbx
    }
}


inline endline() {
    asm {
        mov rcx, -11
        call qword [GetStdHandle]
        mov rcx, rax
        lea rdx, [newline_buf]
        mov r8, 2
        lea r9, [bytesWritten]
        mov qword [rsp+32], 0
        call qword [WriteConsoleA]
    }
}

inline readln_str() {
    asm {
        sub rsp, 40
        mov rcx, -10
        call qword [GetStdHandle]
        mov rcx, rax
        lea rdx, [readln_buf]
        mov r8, 255
        lea r9, [readln_count]
        mov qword [rsp+32], 0
        call qword [ReadConsoleA]
        add rsp, 40
        lea rax, [readln_buf]
        mov edx, [readln_count]
        sub rdx, 2
    }
}

inline readln_int() {
    asm {
        sub rsp, 40
        mov rcx, -10
        call qword [GetStdHandle]
        mov rcx, rax
        lea rdx, [readln_buf]
        mov r8, 255
        lea r9, [readln_count]
        mov qword [rsp+32], 0
        call qword [ReadConsoleA]
        add rsp, 40

        lea rdi, [readln_buf]
        xor rax, rax
        xor rcx, rcx
    .readln_int_loop:
        movzx rcx, byte [rdi]
        cmp rcx, '0'
        jb .readln_int_done
        cmp rcx, '9'
        ja .readln_int_done
        sub rcx, '0'
        imul rax, 10
        add rax, rcx
        inc rdi
        jmp .readln_int_loop
    .readln_int_done:
    }
}

inline GetStdHandle() {
    asm {
        invoke GetStdHandle, -11
        WSTORE hStdOut, t0_64
    }
}

inline Exit() {
    asm {
        invoke ExitProcess, 0
    }
}

inline WindowsShadowSpace() {
    asm {
        and rsp, -16
        sub rsp, 48
    }
}