@data {
    WVAR hStdOut, i64, ?
    WVAR bytesWritten, i32, ?
}

@include.inc {
    "win64w.inc"
}

@library kernel32 {
    GetStdHandle
    WriteConsoleA
    ExitProcess
}

fn WriteConsoleA(s: str, len: i32) {
    asm {
        sub rsp, 40
        mov rcx, -11
        call qword [GetStdHandle]
        mov rcx, rax
        lea rdx, [{s}]
        mov r8, {len}
        lea r9, [rsp+32]
        mov qword [rsp+32], 0
        call qword [WriteConsoleA]
        add rsp, 40
    }
}

fn GetStdHandle() {
    asm {
        invoke GetStdHandle, -11
        WSTORE hStdOut, t0_64
    }
}

fn Exit() {
    asm {
        invoke ExitProcess, 0
    }
}

fn WindowsShadowSpace() {
    asm {
        pop rax
        sub rsp, 8
        and rsp, -16
        sub rsp, 40
        push rax
    }
}