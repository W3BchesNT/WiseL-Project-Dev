@data {
    WVAR hStdOut, i64, ?
    WVAR bytesWritten, i32, ?
}

@include.inc {
    "win64w.inc"
}

@library kernel32 {
    GetStdHandle
    WriteConsoleA
    ExitProcess
    ReadConsoleA
}

inline print_str(s: str) {
    asm {
        sub rsp, 40

        mov rcx, -11
        call qword [GetStdHandle]

        mov rcx, rax
        lea rdx, [{s}]
        mov r8, {s}_len
        lea r9, [rsp+32]

        mov qword [rsp+32], 0
        call qword [WriteConsoleA]
        add rsp, 40
    }
}

inline print_int(n: i32) {
    asm {
        sub rsp, 40
        mov rcx, -11
        call qword [GetStdHandle]
        mov rcx, rax

        lea rdx, [rsp + 32]
        mov eax, {n}
        add al, '0'
        mov [rdx], al
        mov byte [rdx + 1], 10
        mov r8, 2
        lea r9, [rsp + 24]
        mov qword [r9], 0
        call qword [WriteConsoleA]
        add rsp, 40
    }
}

inline WriteConsoleA(s: str, len: i32) {
    asm {
        sub rsp, 40

        mov rcx, -11
        call qword [GetStdHandle]

        mov rcx, rax
        lea rdx, [{s}]
        mov r8, {len}
        lea r9, [rsp+32]

        mov qword [rsp+32], 0
        call qword [WriteConsoleA]
        add rsp, 40
    }
}

inline endline() {
    asm {
        sub rsp, 312
        mov rcx, -10
        call qword [GetStdHandle]
        mov rcx, rax
        lea rdx, [rsp+40]
        mov r8, 255
        lea r9, [rsp+296]
        mov qword [r9], 0
        call qword [ReadConsoleA]
        add rsp, 312
    }
}

inline GetStdHandle() {
    asm {
        invoke GetStdHandle, -11
        WSTORE hStdOut, t0_64
    }
}

inline Exit() {
    asm {
        invoke ExitProcess, 0
    }
}

inline WindowsShadowSpace() {
    asm {
        sub rsp, 8
        and rsp, -16
        sub rsp, 40
    }
}

inline DisabledWindowsShadowSpace() {
    asm {
        pop rax
        sub rsp, 8
        and rsp, -16
        sub rsp, 40
        push rax
    }
}