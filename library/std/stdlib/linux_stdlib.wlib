inline syscall(a: any, b: any, c: any) {
    asm {
        mov rax, {a}
        mov rdi, {b}
        lea rsi, [{c}]
        mov rdx, {c}_len
        syscall
    }
}

inline print_str(s: str) {
    asm {
        mov rax, 1
        mov rdi, 1
        lea rsi, [{s}]
        mov rdx, {s}_len
        syscall
    }
}

inline print_int(n: i32) {
    asm {
        sub rsp, 32
        mov eax, {n}
        add al, '0'
        mov [rsp], al
        mov byte [rsp + 1], 10
        mov rax, 1
        mov rdi, 1
        mov rsi, rsp
        mov rdx, 2
        syscall
        add rsp, 32
    }
}

inline endline() {
    asm {
        sub rsp, 272
        mov rax, 0
        mov rdi, 0
        lea rsi, [rsp]
        mov rdx, 256
        syscall
        add rsp, 272
    }
}

inline Exit() {
    asm {
        mov rax, 60
        xor rdi, rdi
        syscall
    }
}