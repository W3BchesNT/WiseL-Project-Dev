Target "Windows"
UseLib "library/stdlib.wlib"

let str_hi: str = "Hello, World!"
let str_hru: str = "How are you?"
let str_new: str = "What are you doing?"
let str_by: str = "Bye, World!"

let a: i32 = 10

fn main() {
    if (a == 10) {
        WriteConsoleA(str_hi, 15)
    } else {
        WriteConsoleA(str_by, 13)
    }

    WriteConsoleA(str_hru, 14)
    WriteConsoleA(str_new, 21)
    Exit()
}
