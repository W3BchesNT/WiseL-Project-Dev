Format "PE64 CONSOLE"
UseLib "library/stdlib.wlib"

func main() {
    GetStdHandle()
    SetConsoleOutputCP()
    let i: i32 = 10
    println("[Print]: Hello, World! ", i)
    printf("[Stdin]: ")
    let a: str = readln()
    if (a == "How are you?") {
        println("I'm fine! what about you?")
    }
    println("[Stdout]: ", a)
    printf("Press any key to continue . . . ")
    readln()
    ExitProcess()
}