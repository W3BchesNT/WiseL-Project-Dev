Target "Linux"
UseLib "library/stdlib.wlib"

let str_hi: str = "Hello, World!"
let str_hru: str = "How are you?"
let str_new: str = "What are you doing?"
let str_by: str = "Bye, World!"

let a: i32 = 10

fn main() {
    @target="Windows" {
        WindowsShadowSpace()
    }
    println(str_hi)
    if (a == 1) {
        println("Hello, World!")
    } else {
        println("Bye, World!")
    }

    println(str_hru)
    println(str_new)
    endline()
    Exit()
}
