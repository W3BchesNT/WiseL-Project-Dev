Target "Windows"
UseLib "library/stdlib.wlib"

let str_hi: str = "Hello, World!"
let str_hru: str = "How are you?"
let str_new: str = "What are you doing?"
let str_by: str = "Bye, World!"

let a: i32 = 10

fn add(a: i32, b: i32) {
    return a + b
}

fn main() {
    @target="Windows" {
        WindowsShadowSpace()
    }
    let mo: i32 = add(2, 3)
    print_int(mo)
    print_str(str_new)
    if (a > 1) {
        print_str("Hello, World!")
    } else {
        print_str("Bye, World!")
    }
    Exit()
}